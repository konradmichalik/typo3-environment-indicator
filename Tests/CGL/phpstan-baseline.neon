parameters:
	ignoreErrors:
		-
			message: '#^Using \$_SERVER is forbidden, Use PSR\-7 API instead\.$#'
			identifier: disallowed.variable
			count: 1
			path: ../../Classes/Configuration/Trigger/Ip.php

		-
			message: '#^Access to private property Intervention\\Image\\ImageManager\:\:\$driver\.$#'
			identifier: property.private
			count: 1
			path: ../../Classes/Utility/GeneralHelper.php

		-
			message: '#^Call to function method_exists\(\) with Intervention\\Image\\Interfaces\\ImageManagerInterface and ''driver'' will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: ../../Classes/Utility/GeneralHelper.php

		-
			message: '#^Method KonradMichalik\\Typo3EnvironmentIndicator\\Utility\\ImageDriverUtility\:\:resolveVipsDriver\(\) should return Intervention\\Image\\Interfaces\\DriverInterface but returns Intervention\\Image\\Drivers\\Vips\\Driver\.$#'
			identifier: return.type
			count: 1
			path: ../../Classes/Utility/ImageDriverUtility.php

		-
			message: '#^Call to an undefined method Intervention\\Image\\Interfaces\\ImageInterface\:\:insert\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: ../../Classes/Utility/ImageManagerHelper.php

		-
			message: '#^Call to an undefined method Intervention\\Image\\Interfaces\\ImageManagerInterface\:\:decode\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: ../../Classes/Utility/ImageManagerHelper.php

		-
			message: '#^Call to an undefined method object\:\:background\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: ../../Classes/Utility/ImageManagerHelper.php

		-
			message: '#^Call to an undefined method object\:\:border\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: ../../Classes/Utility/ImageManagerHelper.php

		-
			message: '#^Call to an undefined method object\:\:diameter\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: ../../Classes/Utility/ImageManagerHelper.php

		-
			message: '#^Call to an undefined method object\:\:radius\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: ../../Classes/Utility/ImageManagerHelper.php

		-
			message: '#^Call to an undefined method object\:\:size\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: ../../Classes/Utility/ImageManagerHelper.php

		-
			message: '#^Call to function method_exists\(\) with ''Intervention\\\\Image\\\\ImageManager'' and ''decode'' will always evaluate to false\.$#'
			identifier: function.impossibleType
			count: 1
			path: ../../Classes/Utility/ImageManagerHelper.php

		-
			message: '#^Method Intervention\\Image\\Interfaces\\ImageInterface\:\:drawCircle\(\) invoked with 1 parameter, 3 required\.$#'
			identifier: arguments.count
			count: 1
			path: ../../Classes/Utility/ImageManagerHelper.php

		-
			message: '#^Method Intervention\\Image\\Interfaces\\ImageInterface\:\:drawRectangle\(\) invoked with 1 parameter, 3 required\.$#'
			identifier: arguments.count
			count: 1
			path: ../../Classes/Utility/ImageManagerHelper.php

		-
			message: '#^Method Intervention\\Image\\Typography\\FontFactory\:\:align\(\) invoked with 2 parameters, 1 required\.$#'
			identifier: arguments.count
			count: 1
			path: ../../Classes/Utility/ImageManagerHelper.php

		-
			message: '#^Parameter \#1 \$x of method Intervention\\Image\\Interfaces\\ImageInterface\:\:drawCircle\(\) expects int, Closure given\.$#'
			identifier: argument.type
			count: 1
			path: ../../Classes/Utility/ImageManagerHelper.php

		-
			message: '#^Parameter \#1 \$x of method Intervention\\Image\\Interfaces\\ImageInterface\:\:drawRectangle\(\) expects int, Closure given\.$#'
			identifier: argument.type
			count: 1
			path: ../../Classes/Utility/ImageManagerHelper.php

		-
			message: '#^Variable method call on Intervention\\Image\\Interfaces\\ImageInterface\.$#'
			identifier: method.dynamicName
			count: 4
			path: ../../Classes/Utility/ImageManagerHelper.php

		-
			message: '#^Variable method call on Intervention\\Image\\Interfaces\\ImageManagerInterface\.$#'
			identifier: method.dynamicName
			count: 1
			path: ../../Classes/Utility/ImageManagerHelper.php

		-
			message: '#^Variable method call on Intervention\\Image\\Typography\\FontFactory\.$#'
			identifier: method.dynamicName
			count: 2
			path: ../../Classes/Utility/ImageManagerHelper.php

		-
			message: '#^Method KonradMichalik\\Typo3EnvironmentIndicator\\Utility\\SvgRasterizer\:\:rasterize\(\) should return GdImage\|null but returns resource\.$#'
			identifier: return.type
			count: 1
			path: ../../Classes/Utility/SvgRasterizer.php

		-
			message: '#^Strict comparison using \=\=\= between null and TYPO3Fluid\\Fluid\\Core\\Rendering\\RenderingContextInterface will always evaluate to false\.$#'
			identifier: identical.alwaysFalse
			count: 1
			path: ../../Classes/ViewHelpers/FaviconViewHelper.php
